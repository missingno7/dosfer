+
+/* Keep the Mode 0Dh memory layout and 200 logical scan lines, but extend
+ * the vertical period to 525 physical scan lines.  Mode 0Dh already uses
+ * double scanning, so the active image remains 320x200 while the refresh
+ * changes from about 70 Hz to about 59.94 Hz.
+ *
+ * These values are the established 320x200/60 timing for the standard
+ * 25.175 MHz VGA clock.  Only vertical CRTC timing changes; page stride,
+ * planar addressing and the two legacy display pages remain unchanged. */
+static void vga_set_320x200_60(void) {
+    u16 crtc=(inp(0x3CC)&1)?0x3D4:0x3B4;
+
+    /* CR11 bit 7 protects CR00..CR07. */
+    outp(crtc,0x11);outp(crtc+1,0x00);
+
+    /* 525-line vertical period, 400 active physical scan lines. */
+    outp(crtc,0x06);outp(crtc+1,0x0B);
+    outp(crtc,0x07);outp(crtc+1,0x3E);
+    outp(crtc,0x16);outp(crtc+1,0x0B);
+    outp(crtc,0x10);outp(crtc+1,0xD7);
+
+    /* Two-line vertical sync and re-enable CRTC write protection. */
+    outp(crtc,0x11);outp(crtc+1,0x89);
+}
